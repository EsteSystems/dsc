{
  "name": "@este-systems/dsc",
  "version": "0.1.0",
  "description": "CLI coding agent for DeepSeek",
  "keywords": [
    "deepseek",
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "repl",
    "tools"
  ],
  "author": "Este Systems <contact@este.systems>",
  "license": "MIT",
  "homepage": "https://github.com/EsteSystems/dsc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EsteSystems/dsc.git"
  },
  "bugs": {
    "url": "https://github.com/EsteSystems/dsc/issues"
  },
  "type": "module",
  "bin": {
    "dsc": "./bin/dsc.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/index.js",
    "package": "node scripts/package.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
