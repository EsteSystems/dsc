{
  "name": "dsc",
  "version": "0.1.0",
  "description": "Claude-Code-style CLI coding agent for DeepSeek",
  "type": "module",
  "bin": {
    "dsc": "./bin/dsc.mjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
