{
  "name": "@este.systems/dsc",
  "version": "1.3.0",
  "description": "Dev Shell Companion — a CLI coding agent that lives in your terminal",
  "keywords": [
    "deepseek",
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "tui",
    "tools"
  ],
  "author": "Este Systems <contact@este.systems>",
  "license": "MIT",
  "homepage": "https://github.com/EsteSystems/dsc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EsteSystems/dsc.git"
  },
  "bugs": {
    "url": "https://github.com/EsteSystems/dsc/issues"
  },
  "type": "module",
  "bin": {
    "dsc": "bin/dsc.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/tui.tsx",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test",
    "start": "node dist/tui.js",
    "package": "node scripts/package.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "ws": "^8.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "diff": "^5.2.0",
    "ink": "^7.0.2",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/diff": "^5.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
